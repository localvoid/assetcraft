{
  "name": "assetcraft",
  "version": "0.1.2",
  "description": "Web Assets Toolkit",
  "keywords": [],
  "homepage": "https://github.com/localvoid/assetcraft",
  "bugs": "https://github.com/localvoid/assetcraft/issues",
  "license": "(MIT OR Apache-2.0)",
  "author": "Boris Kaul <localvoid@gmail.com> (https://github.com/localvoid)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/localvoid/assetcraft.git"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./manifest": "./dist/manifest.js",
    "./manifest/build": "./dist/manifest/build.js",
    "./manifest/diff": "./dist/manifest/diff.js",
    "./manifest/entry": "./dist/manifest/entry.js",
    "./manifest/prune": "./dist/manifest/prune.js",
    "./manifest/validate": "./dist/manifest/validate.js",
    "./deploy": "./dist/deploy.js",
    "./file": "./dist/file.js",
    "./compress": "./dist/compress.js",
    "./http": "./dist/http.js"
  },
  "scripts": {
    "build": "tsc -b",
    "format": "oxfmt",
    "check": "oxlint",
    "test": "bun test tests/",
    "clean": "rm -rf tsconfig.tsbuildinfo ./dist ./node_modules"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
